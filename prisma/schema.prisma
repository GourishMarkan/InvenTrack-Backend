// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
    // url      = env("[DATABASE_URL")  
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  password  String
  role      Role     @default(User)
  isDeleted Boolean @default(false)
  createdProducts Product[] @relation("CreatedProducts")
  updatedProducts Product[] @relation("UpdatedProducts")
  userPurchases Purchase[] @relation("UserPurchases")   
  stockMovement StockMovement[] @relation("UserStockMovement")
  userCreatedOrder Order[] @relation("UserCreatedOrder")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  products  Product[]
  purchases Purchase[]
  mobileNumber String
  isDeleted Boolean @default(false)
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  costPrice     Int
  sellingPrice  Int
  stock         Int
  supplierId    Int
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  createdAt     DateTime       @default(now())
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  isDeleted Boolean @default(false)
  stockMovements StockMovement[]
  createdById Int
  updatedById Int
 createdBy User @relation("CreatedProducts",fields: [createdById],references: [id])
  updatedBy User @relation("UpdatedProducts",fields: [updatedById],references: [id])
  
}

// order model
model OrderItem {
  id           Int      @id @default(autoincrement())
  productId    Int
  quantity     Int
  orderId      Int
  sellingPrice Int
  costPrice    Int
  createdAt    DateTime @default(now())
  product        Product         @relation(fields: [productId], references: [id])
  order          Order           @relation(fields: [orderId], references: [id])
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([productId])
}

model Order {
  id            Int           @id @default(autoincrement())
  // createdBy Int
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  total         Int
  paymentType   PaymentType   @default(Cash)
  paymentStatus PaymentStatus @default(Pending)
  createdBy  Int
  userCreatedOrder User @relation("UserCreatedOrder",fields: [createdBy],references: [id])

}

// purchase model--
model Purchase {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  total         Int
  purchaseItem  PurchaseItem[]
  paymentType   PaymentType    @default(Cash)
  paymentStatus PaymentStatus  @default(Pending)
  totalQuantity Int
  supplierId    Int
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate  DateTime
  createdBy Int 
  user User @relation("UserPurchases",fields: [createdBy],references: [id])
  @@index([supplierId])
}

// purchase Item

model PurchaseItem {
  id             Int             @id @default(autoincrement())
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  purchaseId     Int // Add foreign key
  purchase       Purchase        @relation(fields: [purchaseId], references: [id])
  costPrice      Int
  quantity       Int
  stockMovements StockMovement[]
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  productId      Int
  orderItemId    Int?
  purchaseItemId Int?
  quantity       Int
  createdAt      DateTime          @default(now())
  type           StockMovementType @default(Purchase)
  product        Product           @relation(fields: [productId], references: [id])
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id])
  purchaseItem   PurchaseItem?     @relation(fields: [purchaseItemId], references: [id])
  createdById Int 
  userStockMovement User @relation("UserStockMovement",fields: [createdById],references: [id])
  @@index([orderItemId])
  @@index([purchaseItemId])
  @@index([productId])
}

enum PaymentType {
  Cash
  Upi
  CreditCard
  DebitCard
}

enum PaymentStatus {
  Done
  Pending
  Failed
}

enum Role {
  User
  Admin
}

enum StockMovementType {
  Sale
  Purchase
  Wastage
  Adjustment
}

